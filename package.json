{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:production": "pnpm build",
    "start": "next start",
    "stylelint:check": "npx stylelint \"**/*.{css,scss}\"",
    "stylelint:fix": "stylelint --fix src/{,*/}*.{scss,css} --allow-empty-input",
    "lint": "eslint src --ext .jsx,.js,.tsx,.ts  --no-error-on-unmatched-pattern --fix",
    "lint:check": "eslint .",
    "format": "prettier . --write .",
    "format:check": "prettier . --check",
    "type:check": "tsc -b --noEmit",
    "check": "pnpm type:check && pnpm lint:check && pnpm format:check",
    "prepare": "husky"
  },
  "dependencies": {
    "@candy.thieves/ui-kit-lumos": "^0.0.11",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.12",
    "clsx": "^2.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript-eslint": "^8.65.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@it-incubator/prettier-config": "^0.1.2",
    "@it-incubator/stylelint-config": "^2.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "stylelint": "^17.14.0",
    "typescript": "^5"
  },
  "lint-staged": {
    "**/*.{jsx,js,tsx,ts}": [
      "eslint --quiet --fix"
    ],
    "**/*.{css,scss}": [
      "stylelint --fix --allow-empty-input"
    ],
    "**/*": [
      "prettier --write --ignore-unknown"
    ]
  }
}
