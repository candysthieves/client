{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:host": "next dev --hostname dev.lumosapp.net --port 3000 --experimental-https",
    "dev:no-tls": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 pnpm dev:host",
    "build": "next build",
    "build:production": "pnpm build",
    "start": "next start",
    "stylelint:check": "npx stylelint \"src/**/*.{scss,css}\" --allow-empty-input",
    "stylelint:fix": "stylelint --fix src/{,*/}*.{scss,css} --allow-empty-input",
    "lint": "eslint src --ext .jsx,.js,.tsx,.ts --no-error-on-unmatched-pattern --fix",
    "lint:check": "eslint .",
    "format": "prettier . --write .",
    "format:check": "prettier . --check",
    "type:check": "tsc -b --noEmit",
    "check": "pnpm type:check && pnpm lint:check && pnpm format:check",
    "prepare": "husky",
    "dev:server": "nodemon src/json-server/index.js"
  },
  "dependencies": {
    "@candy.thieves/ui-kit-lumos": "^0.0.35",
    "@eslint/js": "^10.0.1",
    "@hookform/resolvers": "^5.7.1",
    "@next/eslint-plugin-next": "^16.2.12",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/json-server": "^0.14.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-google-recaptcha": "^2.1.0",
    "react-hook-form": "^7.85.0",
    "react-hot-toast": "^2.6.0",
    "typescript-eslint": "^8.65.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@it-incubator/prettier-config": "^0.1.2",
    "@it-incubator/stylelint-config": "^2.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-google-recaptcha": "^2.1.9",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "json-server": "0.17.4",
    "lint-staged": "^17.3.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "sass": "^1.102.0",
    "stylelint": "^17.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "lint-staged": {
    "**/*.{jsx,js,tsx,ts}": [
      "eslint src --ext .jsx,.js,.tsx,.ts --fix --quiet --no-error-on-unmatched-pattern"
    ],
    "**/*.{css,scss}": [
      "stylelint --fix --allow-empty-input"
    ],
    "**/*": [
      "prettier --write --ignore-unknown"
    ]
  }
}
